        "align",
        "distill_lexicon",
        "distill_morphology",
        "distill_grammar",
        "audio_align",
        "human_review",
        "third_party_api",
        "cloud_processing",
        "redistribute_raw",
        "redistribute_derived",
        "direct_training",
        "synthetic_generation_support",
        "evaluation"
      ],
      "title": "Operation",
      "type": "string"
    }
  },
  "$id": "urn:langpipe:schema:source-use-approval:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
