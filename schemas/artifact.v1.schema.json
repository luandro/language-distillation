{
  "$defs": {
    "AccessClass": {
      "enum": [
        "public",
        "community",
        "restricted",
        "highly_restricted"
      ],
      "title": "AccessClass",
      "type": "string"
    },
    "ArtifactKind": {
      "enum": [
        "ingest_report",
        "extraction_snapshot",
        "alignment_file",
        "cldf_export",
        "benchmark_report",
        "dataset",
        "other",
        "extraction_report",
        "extraction_error",
        "normalization_report",
        "tokenization_report"
      ],
      "title": "ArtifactKind",
      "type": "string"
    }
  },
  "$id": "urn:langpipe:schema:artifact:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "access_class": {
      "$ref": "#/$defs/AccessClass"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "pattern": "^artifact_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ArtifactKind"
    },
    "media_type": {
      "title": "Media Type",
      "type": "string"
    },
    "run_id": {
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Schema Name"
    },
    "schema_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Schema Version"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "run_id",
    "kind",
    "media_type",
    "sha256",
    "size_bytes",
    "access_class",
    "created_at"
  ],
  "title": "Artifact",
  "type": "object",
  "x-schema-name": "artifact",
  "x-schema-version": 1
}
