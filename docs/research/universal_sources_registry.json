  "repository_taxonomy": {
    "scholarly_aggregators": [
      {
        "id": "openalex",
        "name": "OpenAlex Global Scholarly Graph",
        "type": "rest_api",
        "endpoint": "https://api.openalex.org/works",
        "rate_limit": "10 req/s with mailto header",
        "features": [
          "open_access_pdf_resolution",
          "doi_resolution",
          "author_graph",
          "citation_traversal"
        ],
        "search_template": "{endpoint}?search={language_name}+{family}&filter=default.search:{language_name}"
      },
      {
        "id": "zenodo",
        "name": "Zenodo Open Science Archive",
        "type": "rest_api",
        "endpoint": "https://zenodo.org/api/records",
        "rate_limit": "60 req/min",
        "features": [
          "direct_file_download",
          "cc_license_metadata",
          "igt_data",
          "language_science_press_books"
        ],
        "search_template": "{endpoint}?q={language_name}&type=publication"
      },
      {
        "id": "bdtd",
        "name": "Biblioteca Digital Brasileira de Teses e Dissertações (IBICT)",
        "type": "vufind_rest_api",
        "endpoint": "https://bdtd.ibict.br/vufind/api/v1/search",
        "rate_limit": "30 req/min",
        "features": [
          "brazilian_academic_theses",
          "handle_resolution",
          "full_text_links",
          "indigenous_studies"
        ],
        "search_template": "{endpoint}?lookfor={language_name}&type=AllFields"
      }
    ],
    "linguistic_archives": [
      {
        "id": "glottolog",
        "name": "Glottolog Language Reference",
        "type": "rest_api",
        "endpoint": "https://glottolog.org/resource/languoid/id/{glottocode}.json",
        "features": [
          "family_tree",
          "geographic_coordinates",
          "iso_mapping",
          "exhaustive_bibliography"
        ]
      },
      {
        "id": "asjp",
        "name": "Automated Similarity Judgment Program (ASJP)",
        "type": "clld_web",
        "endpoint": "https://asjp.clld.org/languages/{asjp_code}",
        "features": [
          "swadesh_100_wordlist",
          "standardized_phonetic_transcription",
          "cognate_sets"
        ]
      },
      {
        "id": "etnolinguistica",
        "name": "Biblioteca Digital Curt Nimuendajú / Etnolinguistica.org",
        "type": "curated_archive_crawl",
        "endpoint": "http://www.etnolinguistica.org/lingua:{iso639_3}",
        "features": [
          "rare_grammars",
          "amazonian_linguistics",
          "historical_manuscripts",
          "vocabularies"
        ]
      },
      {
        "id": "cla_berkeley",
        "name": "California Language Archive (CLA)",
        "type": "oai_pmh_web",
        "endpoint": "https://cla.berkeley.edu",
        "features": [
          "field_recordings",
          "linguistic_notebooks",
          "indigenous_texts"
        ]
      },
      {
        "id": "ailla",
        "name": "Archive of the Indigenous Languages of Latin America (AILLA)",
        "type": "digital_repository",
        "endpoint": "https://ailla.utexas.edu",
        "features": [
          "igt_corpora",
          "audio_transcriptions",
          "ethnographic_texts"
        ]
      },
      {
        "id": "prodoclin",
        "name": "Programa de Documentação de Línguas Indígenas (Museu do Índio / UNESCO)",
        "type": "institutional_archive",
        "endpoint": "http://prodoc.museudoindio.gov.br",
        "features": [
          "field_recordings",
          "dictionaries",
          "cultural_documentation"
        ]
      }
    ],
    "parallel_corpora": [
      {
        "id": "scriptureearth",
        "name": "ScriptureEarth (SIL / Wycliffe)",
        "type": "structured_web",
        "endpoint": "https://www.scriptureearth.org/00por.php?iso={iso639_3}",
        "features": [
          "usfm_scripture",
          "aligned_mp3_audio",
          "timing_files",
          "high_token_volume"
        ]
      },
      {
        "id": "grn",
        "name": "Global Recordings Network",
        "type": "rest_api_scrape",
        "endpoint": "https://globalrecordings.net/pt/language/{iso639_3}",
        "features": [
          "audio_phrasebooks",
          "multilingual_scripts",
          "evangelical_oral_texts"
        ]
      }
    ]
  },
